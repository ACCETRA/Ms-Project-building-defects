{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/bdi/schemas/finding-record-v1.json",
  "title": "Building Defect Inspection Finding Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "finding_id",
    "project_id",
    "inspection_id",
    "created_at",
    "image",
    "location",
    "prediction",
    "measurement",
    "review",
    "provenance",
    "evidence_links",
    "limitation_codes"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0-beta" },
    "finding_id": { "$ref": "#/$defs/nonEmptyString" },
    "project_id": { "$ref": "#/$defs/nonEmptyString" },
    "inspection_id": { "$ref": "#/$defs/nonEmptyString" },
    "created_at": { "type": "string", "format": "date-time" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_image_id", "parent_image_id", "uri", "sha256", "width_pixels", "height_pixels", "capture_mode", "quality"],
      "properties": {
        "source_image_id": { "$ref": "#/$defs/nonEmptyString" },
        "parent_image_id": { "type": ["string", "null"] },
        "uri": { "$ref": "#/$defs/nonEmptyString" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "width_pixels": { "type": "integer", "minimum": 1 },
        "height_pixels": { "type": "integer", "minimum": 1 },
        "captured_at": { "type": ["string", "null"], "format": "date-time" },
        "capture_mode": { "enum": ["handheld", "UAV", "fixed_camera", "unknown"] },
        "camera_id": { "type": ["string", "null"] },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "flags"],
          "properties": {
            "decision": { "enum": ["accepted", "accepted_with_warning", "rejected"] },
            "flags": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["blur", "underexposed", "overexposed", "low_resolution", "occlusion", "compression", "out_of_distribution", "other"] }
            },
            "notes": { "type": ["string", "null"] }
          }
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site_id", "building_id"],
      "properties": {
        "site_id": { "$ref": "#/$defs/nonEmptyString" },
        "building_id": { "$ref": "#/$defs/nonEmptyString" },
        "elevation_or_facade": { "type": ["string", "null"] },
        "floor": { "type": ["string", "null"] },
        "room_or_zone": { "type": ["string", "null"] },
        "element_type": { "enum": ["wall", "slab", "beam", "column", "ceiling", "foundation", "masonry", "other", "unknown"] },
        "gps": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["latitude", "longitude"],
          "properties": {
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
            "altitude_m": { "type": ["number", "null"] }
          }
        }
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immutable", "defect_family", "subtype", "confidence", "geometry", "pipeline_route", "escalation_state"],
      "properties": {
        "immutable": { "const": true },
        "defect_family": { "$ref": "#/$defs/defectFamily" },
        "subtype": { "enum": ["linear", "network_alligator", "with_deposit", "unspecified", "not_applicable"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["coordinate_space", "box_xywh"],
          "properties": {
            "coordinate_space": { "const": "source_image_pixels" },
            "box_xywh": {
              "type": "array",
              "prefixItems": [
                { "type": "number", "minimum": 0 },
                { "type": "number", "minimum": 0 },
                { "type": "number", "exclusiveMinimum": 0 },
                { "type": "number", "exclusiveMinimum": 0 }
              ],
              "minItems": 4,
              "maxItems": 4
            },
            "mask": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["encoding", "size", "counts"],
                  "properties": {
                    "encoding": { "const": "coco_rle" },
                    "size": {
                      "type": "array",
                      "prefixItems": [{ "type": "integer", "minimum": 1 }, { "type": "integer", "minimum": 1 }],
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "counts": { "type": ["string", "array"] }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["encoding", "points"],
                  "properties": {
                    "encoding": { "const": "polygon_xy" },
                    "points": {
                      "type": "array",
                      "minItems": 3,
                      "items": {
                        "type": "array",
                        "prefixItems": [{ "type": "number" }, { "type": "number" }],
                        "minItems": 2,
                        "maxItems": 2
                      }
                    }
                  }
                }
              ]
            },
            "centerline_uri": { "type": ["string", "null"] }
          }
        },
        "pipeline_route": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "escalation_state": { "enum": ["not_required", "selected", "completed", "failed", "manual_review"] }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scale_status", "pixel"],
      "properties": {
        "scale_status": { "enum": ["not_provided", "valid", "invalid", "out_of_plane"] },
        "scale_method": { "enum": ["none", "reference_marker", "camera_planar_calibration", "UAV_GSD", "registered_3d"] },
        "pixel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "length": { "type": ["number", "null"], "minimum": 0 },
            "max_width": { "type": ["number", "null"], "minimum": 0 },
            "area": { "type": ["number", "null"], "minimum": 0 }
          }
        },
        "physical": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit", "length", "max_width", "area", "uncertainty"],
          "properties": {
            "unit": { "enum": ["mm", "cm"] },
            "length": { "type": ["number", "null"], "minimum": 0 },
            "max_width": { "type": ["number", "null"], "minimum": 0 },
            "area": { "type": ["number", "null"], "minimum": 0 },
            "uncertainty": { "type": "number", "minimum": 0 }
          }
        }
      },
      "allOf": [
        {
          "if": { "required": ["physical"] },
          "then": {
            "properties": {
              "scale_status": { "const": "valid" },
              "scale_method": { "enum": ["reference_marker", "camera_planar_calibration", "UAV_GSD", "registered_3d"] }
            },
            "required": ["scale_method"]
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reviewer_id", "reviewed_at", "reviewer_label", "notes"],
      "properties": {
        "state": { "enum": ["unreviewed", "approved", "rejected", "relabelled", "escalated"] },
        "reviewer_id": { "type": ["string", "null"] },
        "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
        "reviewer_label": { "oneOf": [{ "$ref": "#/$defs/defectFamily" }, { "type": "null" }] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "checkpoint_sha256", "pipeline_version", "taxonomy_version", "dataset_manifest_version", "runtime"],
      "properties": {
        "model_id": { "$ref": "#/$defs/nonEmptyString" },
        "checkpoint_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "pipeline_version": { "$ref": "#/$defs/nonEmptyString" },
        "taxonomy_version": { "$ref": "#/$defs/nonEmptyString" },
        "dataset_manifest_version": { "$ref": "#/$defs/nonEmptyString" },
        "runtime": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "evidence_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["modality", "uri", "status"],
        "properties": {
          "modality": { "enum": ["RGB", "thermal", "GPR", "3d", "historical_record"] },
          "uri": { "$ref": "#/$defs/nonEmptyString" },
          "status": { "enum": ["source", "registered", "unregistered", "future_placeholder"] }
        }
      }
    },
    "limitation_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["candidate_only", "qualified_review_required", "not_structural_safety_determination", "uncalibrated_measurement", "low_image_quality", "out_of_domain"] }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "defectFamily": { "enum": ["crack", "spalling", "honeycombing_rock_pocket", "exposed_rebar", "rust_staining", "efflorescence_leaching", "no_visible_target_defect", "unknown_review"] }
  }
}
